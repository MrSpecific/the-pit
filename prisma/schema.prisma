// The Pit — database schema.
//
// The premise: anyone can pay whatever they want to drop a name + message into
// the pit. Once payment clears, the message becomes public and shows up live
// (Supabase Realtime) in everyone's feed.
//
// Prisma is used here ONLY to define and migrate the schema. Runtime queries go
// through the Supabase JS client (PostgREST), not Prisma Client, so we never
// generate or ship @prisma/client — hence there's no `generator` block.
//
// Tables/columns are mapped to snake_case so they're idiomatic Postgres and
// clean to query from supabase-js.
//
// The connection URL lives in prisma.config.ts (Prisma 7+), not here.

datasource db {
  provider = "postgresql"
}

/// One entry in the pit. Created (unpaid) when checkout starts, then flipped to
/// paid by the verified Stripe webhook. Only paid rows are publicly visible
/// (see sql/rls_and_realtime.sql).
model Message {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String    @db.VarChar(80)
  message               String    @db.VarChar(500)
  amountCents           Int       @map("amount_cents")
  currency              String    @default("usd")
  paid                  Boolean   @default(false)
  stripeSessionId       String?   @map("stripe_session_id")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(6)
  // Set when the payment is refunded; refunded messages drop out of the feed.
  refundedAt            DateTime? @map("refunded_at") @db.Timestamptz(6)

  // The public feed reads paid rows newest-first.
  @@index([paid, createdAt])
  // The refund webhook looks a message up by its payment intent.
  @@index([stripePaymentIntentId])
  @@map("messages")
}

/// Stripe webhook idempotency ledger. The webhook records each event id here
/// before processing; the unique constraint makes redelivered events no-ops.
model WebhookEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("webhook_events")
}
