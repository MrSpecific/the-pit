# Used by the Prisma CLI on YOUR machine for migrations (not by the Worker).
# Supabase dashboard > Project Settings > Database > Connection string (ORM tab).

# Pooled connection (Supavisor, transaction mode, port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[email protected]:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — required for `prisma migrate`.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[email protected]:5432/postgres"
