# Used by the Prisma CLI on YOUR machine for migrations (not by the Worker).
# Loaded by prisma.config.ts via dotenv. Prisma 7 no longer auto-loads .env.
# Supabase dashboard > Project Settings > Database > Connection string (ORM tab).

# Direct connection (port 5432) — used by `prisma migrate`. This is the only
# connection string Prisma needs; runtime DB access goes through supabase-js,
# so the pooled (Supavisor, 6543) URL isn't required here.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[email protected]:5432/postgres"

# --- Frontend (Vite) --------------------------------------------------------
# Baked into the client bundle at build time. The publishable key is safe to
# expose — RLS only exposes paid messages. Supabase dashboard > Project
# Settings > API Keys (publishable key, formerly the "anon" key).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
